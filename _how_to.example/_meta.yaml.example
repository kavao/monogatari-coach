# 作品フォルダ直下に _meta.yaml として置く雛形（機械可読メタ）
# 散文・進捗・§4/§5 表は _meta.md のまま。本ファイルはバッチが読む定量設定用。
# 新規作品: python tools/novel_scaffold.py novels/NNN_作品名

version: 1

novelai:
  portion_default: cross_flat
  portion_fallback: cross_flat

  portions:
    cross_flat:
      label: 横断・普段使い（フラット画風）
      path: _how_to/image_refs/novelai/2026-05-17_flat.naiv4vibebundle
      # バンドル内 importInfo への乗数（1.0 = UI エクスポート値どおり）
      strength: 1.0
      information_extracted: 1.0

    work_manga:
      label: 本作品・漫画コマ既定
      path: references/novelai/WORK_CODE_scene.naiv4vibebundle
      strength: 1.0
      information_extracted: 1.0
