# Normalize text files in the repository and keep source/config files LF.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.example text eol=lf
*.lock text eol=lf
*.sh text eol=lf

# Windows scripts may stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
